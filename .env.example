# Salin ke .env lalu isi. JANGAN commit .env (sudah di-ignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# WAJIB, minimal 32 karakter acak. Tanpa ini semua login & API admin ditolak (tidak ada nilai fallback).
# Contoh membuat:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mengganti nilai ini akan mengeluarkan (logout paksa) semua admin yang sedang login.
JWT_SECRET=
